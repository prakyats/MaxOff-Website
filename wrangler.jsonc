{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxoff-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Astro builds privacy.html-style files; serve /privacy without a trailing slash.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // Only the form endpoint runs the Worker; every other path is a static asset.
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  // Variables set in the dashboard (TURNSTILE_SECRET_KEY, RESEND_API_KEY, LEADS_TO, LEADS_FROM)
  // must survive every deploy. Nothing secret is ever written to this file.
  "keep_vars": true,
  // Phase 6 adds the custom domains here (maxoff.in and www.maxoff.in). Not before.
}
