{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxoff-website",
  "compatibility_date": "2026-09-01",
  // A fully static site: Cloudflare serves ./dist as static assets. There is no Worker code,
  // no route, no variable and no secret.
  "assets": {
    "directory": "./dist",
    // Astro builds privacy.html-style files; serve /privacy without a trailing slash.
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  "preview_urls": true,
  // Cloudflare builds non-production branches with `wrangler preview`, which refuses to run
  // without this block. It can stay empty: a static site has no bindings to give a preview.
  "previews": {},
  // Live domains. Each is a Cloudflare custom domain: Cloudflare creates the proxied DNS record
  // and the certificate. www is redirected to the apex by a Redirect Rule in the Cloudflare
  // dashboard (a static site has no code to do it), which runs before the request reaches this.
  "routes": [
    { "pattern": "maxoff.in", "custom_domain": true },
    { "pattern": "www.maxoff.in", "custom_domain": true },
  ],
}
