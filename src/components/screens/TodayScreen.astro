---
/**
 * The Owner's Today, recreated in HTML/CSS with demo data (Northwind Studio, invented first names).
 * In the hero it plays one moment, once, in CSS only: Kabir's leave is approved, a six-second Undo
 * appears and fades, and the "Needs you first" count goes from 3 to 2. Opacity and transform only,
 * so nothing shifts. Under reduced motion it stays at the first frame. No amounts on any screen.
 */
import Calendar from '@lucide/astro/icons/calendar';
import House from '@lucide/astro/icons/house';
import ListChecks from '@lucide/astro/icons/list-checks';
import Users from '@lucide/astro/icons/users';
import { todayScreen as t } from '../../content/copy';

const tabIcons = [House, ListChecks, Calendar, Users];
---

<div class="today moment">
  <div class="today__status">
    <span>
      {t.time} {t.zone}
    </span>
  </div>
  <div class="today__head">
    <div>
      <p class="today__title">{t.title}</p>
      <p class="today__date">{t.date}</p>
    </div>
    <p class="today__company">{t.company}</p>
  </div>

  <div class="today__section">
    <div class="today__section-head">
      <span>{t.needs.heading}</span>
      <span class="today__count moment__swap">
        <span class="moment__before">{t.needs.before}</span>
        <span class="moment__after">{t.needs.after}</span>
      </span>
    </div>
    {t.needs.rows.map((row, i) => (
      <div class:list={['today__row', { moment__row: i === 0 }]}>
        <span class="today__avatar">{row.who}</span>
        <div class="today__row-text">
          <p class="today__row-title">{row.title}</p>
          <p class="today__row-sub">{row.sub}</p>
        </div>
        {row.done ? (
          <span class="moment__swap">
            <span class="today__pill today__pill--quiet moment__before">{row.action}</span>
            <span class="today__pill today__pill--quiet today__pill--done moment__after">
              {row.done}
            </span>
          </span>
        ) : (
          <span class="today__pill today__pill--quiet">{row.action}</span>
        )}
      </div>
    ))}
  </div>

  <div class="today__section">
    <div class="today__section-head">
      <span>{t.attendance.heading}</span>
    </div>
    <p class="today__line">{t.attendance.text}</p>
  </div>

  <div class="today__section">
    <div class="today__section-head">
      <span>{t.tasks.heading}</span>
    </div>
    {t.tasks.rows.map((row) => (
      <div class="today__row">
        <div class="today__row-text">
          <p class="today__row-title">{row.title}</p>
          <p class:list={['today__row-sub', { today__warn: row.tone === 'warn' }]}>{row.sub}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="today__toast moment__toast">
    <span>{t.toast.text}</span>
    <span class="today__toast-undo">{t.toast.undo}</span>
    <span class="today__toast-timer moment__timer"></span>
  </div>

  <div class="today__tabs">
    {t.tabs.map((label, i) => {
      const Icon = tabIcons[i];
      return (
        <span class:list={['today__tab', { 'today__tab--on': i === 0 }]}>
          {Icon && <Icon stroke-width={1.5} aria-hidden="true" />}
          {label}
        </span>
      );
    })}
  </div>
</div>
