---
/**
 * Crew's My Day, recreated in HTML/CSS with demo data: only what needs them today (not noted,
 * due today, overdue), then today's and tomorrow's shoots and meetings. Crew see only their own
 * work. Overdue is amber; red stays for the logo and the one primary button.
 */
import Calendar from '@lucide/astro/icons/calendar';
import House from '@lucide/astro/icons/house';
import ListChecks from '@lucide/astro/icons/list-checks';
import User from '@lucide/astro/icons/user';
import { myDayScreen as m } from '../../content/copy';

const tabIcons = [House, ListChecks, Calendar, User];
---

<div class="today">
  <div class="today__status">
    <span>
      {m.time} {m.zone}
    </span>
  </div>
  <div class="today__head">
    <div>
      <p class="today__title">{m.title}</p>
      <p class="today__date">{m.date}</p>
    </div>
    <p class="today__company">{m.company}</p>
  </div>

  <div class="today__day">
    <div>
      <p class="today__day-label">{m.day.label}</p>
      <p class="today__day-status">{m.day.status}</p>
    </div>
  </div>

  {m.sections.map((section) => (
    <div class="today__section">
      <div class="today__section-head">
        <span>{section.heading}</span>
      </div>
      {section.rows.map((row) => (
        <div class="today__row">
          <div class="today__row-text">
            <p class="today__row-title">{row.title}</p>
            <p class:list={['today__row-sub', { today__warn: row.tone === 'warn' }]}>{row.sub}</p>
          </div>
          {row.action && <span class="today__pill">{row.action}</span>}
        </div>
      ))}
    </div>
  ))}

  <div class="today__tabs">
    {m.tabs.map((label, i) => {
      const Icon = tabIcons[i];
      return (
        <span class:list={['today__tab', { 'today__tab--on': i === 0 }]}>
          {Icon && <Icon stroke-width={1.5} aria-hidden="true" />}
          {label}
        </span>
      );
    })}
  </div>
</div>
