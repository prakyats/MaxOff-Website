---
/** Phase 1 only: lets the owner move between the design directions. Removed in Phase 2. */
interface Props {
  current: 'index' | 'instrument' | 'glass' | 'editorial';
}

const { current } = Astro.props;

const items = [
  { key: 'index', label: 'All directions', href: '/preview' },
  { key: 'instrument', label: '1 Instrument', href: '/preview/instrument' },
  { key: 'glass', label: '2 Glass', href: '/preview/glass' },
  { key: 'editorial', label: '3 Editorial', href: '/preview/editorial' },
] as const;
---

<aside class="preview-bar" aria-label="Design preview">
  <div class="container-site preview-bar__inner">
    <p>Design preview. Not the final page.</p>
    <nav aria-label="Design directions">
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>
