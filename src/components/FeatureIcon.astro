---
/** A decorative line icon, looked up by key in src/lib/icons.ts. */
import { icons, type IconKey } from '../lib/icons';

interface Props {
  name: IconKey;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
const Icon = icons[name];
---

<Icon size={size} stroke-width={1.5} aria-hidden="true" focusable="false" class={className} />
