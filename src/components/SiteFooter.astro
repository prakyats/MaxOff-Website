---
import { placeholder, site } from '../content/copy';

const year = new Date().getFullYear();
---

<footer class="container-site flex flex-wrap items-center justify-between gap-4 border-t border-border py-8 text-sm text-muted">
  <p>
    © {year} MaxOff. {placeholder.footerLine}
  </p>
  <a href={`mailto:${site.contactEmail}`} class="underline-offset-4 hover:underline">
    {site.contactEmail}
  </a>
</footer>
