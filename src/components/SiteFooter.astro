---
import { footer } from '../content/copy';
import EmailLink from './EmailLink.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const year = new Date().getFullYear();
---

<footer class:list={['site-footer', className]}>
  <div class="container-site site-footer__inner">
    <div class="site-footer__brand">
      <Logo />
      <p>{footer.description}</p>
      <p class="site-footer__credit">{footer.credit}</p>
    </div>
    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        {footer.links.map((link) => (
          <li>
            {link.href === null ? (
              <EmailLink kind="plain">{link.label}</EmailLink>
            ) : (
              <a href={link.href}>{link.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-footer__meta">
      <p>
        © {year} {footer.copyright}
      </p>
      <ThemeToggle />
    </div>
  </div>
</footer>
