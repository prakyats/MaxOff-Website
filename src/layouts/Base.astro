---
import '../styles/global.css';
import { hero, site } from '../content/copy';
import { PRE_LAUNCH } from '../lib/launch';

interface Props {
  title?: string;
  description?: string;
  /** Path used for the canonical URL, e.g. "/privacy". Defaults to the home page. */
  path?: string;
  /** Pages that should never be indexed, even after launch (the 404 page). */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  path = '/',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, site.url).href;
// Social previews need absolute URLs. The image is generated at build time (src/pages/og.png.ts).
const image = new URL('/og.png', site.url).href;
const imageAlt = `${site.name}: ${hero.headline}`;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(PRE_LAUNCH || noindex) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0A0B" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link
      rel="preload"
      href="/fonts/geist-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-mono-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Apply a stored theme before first paint so there is no flash of the wrong theme.
      // Nothing stored: the system preference decides, and dark wins when there is none.
      (function () {
        try {
          const stored = localStorage.getItem('maxoff-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch {
          /* storage unavailable: fall back to the system preference */
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="text-text">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class="site-grid" aria-hidden="true"></div>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
