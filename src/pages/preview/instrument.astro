---
/**
 * Direction 1: Instrument. A strict grid, mono labels, hairlines, information density.
 * Phase 1 preview only. Copy comes from src/content/copy.ts.
 */
import ArrowDown from '@lucide/astro/icons/arrow-down';
import ContactBlock from '../../components/ContactBlock.astro';
import EmailLink from '../../components/EmailLink.astro';
import FeatureIcon from '../../components/FeatureIcon.astro';
import PhoneFrame from '../../components/PhoneFrame.astro';
import PreviewBar from '../../components/PreviewBar.astro';
import TodayScreen from '../../components/screens/TodayScreen.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { closing, cta, hero, liveFeatures, site, todayScreen, what } from '../../content/copy';
import Base from '../../layouts/Base.astro';
import '../../styles/directions/instrument.css';

const specs = [
  { term: 'Roles', value: 'Owner, Admin, Staff' },
  { term: 'Times', value: 'IST' },
  { term: 'History', value: 'Never overwritten' },
  { term: 'Install', value: 'From the browser' },
] as const;

const index = (n: number): string => String(n).padStart(2, '0');
---

<Base
  title={site.title}
  description={site.description}
  path="/preview/instrument"
  bodyClass="dir-instrument"
  noindex
>
  <PreviewBar current="instrument" />
  <SiteHeader homeHref="/preview/instrument" />

  <main id="main">
    <section class="ins-hero" aria-labelledby="hero-title">
      <div class="container-site ins-hero__grid">
        <div class="ins-hero__copy">
          <p class="ins-eyebrow">
            <span>01</span>
            {hero.eyebrow}
          </p>
          <h1 id="hero-title" class="ins-h1">
            {hero.headline}
          </h1>
          <p class="ins-lead">{hero.supporting}</p>
          <div class="ins-actions">
            <EmailLink kind="demo" class="button-primary" primary hint>
              {cta.demo}
            </EmailLink>
            <a class="link-arrow" href="#what">
              {cta.seeHow}
              <ArrowDown size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
          </div>
        </div>

        <div class="ins-hero__device">
          <div class="ins-frame">
            <span class="ins-frame__label ins-frame__label--tl" aria-hidden="true">
              Screen / Today
            </span>
            <span class="ins-frame__label ins-frame__label--br" aria-hidden="true">
              Owner view
            </span>
            <PhoneFrame label={todayScreen.label}>
              <TodayScreen />
            </PhoneFrame>
          </div>
        </div>
      </div>

      <div class="container-site">
        <dl class="ins-specs">
          {specs.map((spec) => (
            <div class="ins-specs__cell">
              <dt>{spec.term}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="what" class="ins-section" aria-labelledby="what-title">
      <div class="container-site">
        <header class="ins-sechead reveal">
          <p class="ins-eyebrow">
            <span>02</span>
            {what.eyebrow}
          </p>
          <h2 id="what-title" class="ins-h2">
            {what.headline}
          </h2>
          <p class="ins-sechead__intro">{what.intro}</p>
        </header>

        <ul class="ins-grid">
          {liveFeatures.map((feature, i) => (
            <li class="ins-cell reveal" style={`--reveal-delay: ${(i % 4) * 60}ms`}>
              <div class="ins-cell__top">
                <span class="ins-cell__index" aria-hidden="true">
                  {index(i + 1)}
                </span>
                <span class="badge-live">{what.badge}</span>
              </div>
              <FeatureIcon name={feature.key} class="ins-cell__icon" />
              <h3 class="ins-cell__title">{feature.title}</h3>
              <p class="ins-cell__text">{feature.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="demo" class="ins-section" aria-labelledby="close-title">
      <div class="container-site ins-close">
        <div class="ins-close__copy reveal">
          <p class="ins-eyebrow">
            <span>03</span>Demo
          </p>
          <h2 id="close-title" class="ins-h2">
            {closing.headline}
          </h2>
          <p class="ins-lead">{closing.line}</p>
        </div>
        <div class="ins-close__panel reveal">
          <ContactBlock />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
