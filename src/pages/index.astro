---
/**
 * The MaxOff home page, in the Instrument direction (docs/DESIGN.md).
 * Sections, in order: hero (the Owner's Today plays one approval), three questions, what it does
 * (a bento of the live features), one app and three views (the role switcher), a day in the
 * studio (a timeline), feels like an app
 * (a lock screen), roles, coming next, trust, how it starts, closing and contact.
 * All copy lives in src/content/copy.ts.
 */
import ArrowDown from '@lucide/astro/icons/arrow-down';
import Lock from '@lucide/astro/icons/lock-keyhole';
import ContactBlock from '../components/ContactBlock.astro';
import EmailLink from '../components/EmailLink.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import FeatureTable from '../components/FeatureTable.astro';
import LiveBento from '../components/LiveBento.astro';
import LockScreen from '../components/LockScreen.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import RoleColumn from '../components/RoleColumn.astro';
import RoleViews from '../components/RoleViews.astro';
import TodayScreen from '../components/screens/TodayScreen.astro';
import SectionHead from '../components/SectionHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  app,
  badges,
  closing,
  coming,
  comingFeatures,
  cta,
  day,
  hero,
  how,
  lockScreen,
  questions,
  roles,
  site,
  todayScreen,
  trust,
  views,
  what,
} from '../content/copy';
import Base from '../layouts/Base.astro';

// Structured data: what the product is, nothing more. No ratings, prices, reviews or publisher
// (docs/BRIEF.md rule: never claim what we cannot show). "<" is escaped so the JSON can never
// close its own script tag.
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  url: site.url,
  description: site.description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
}).replace(/</g, '\\u003c');
---

<Base>
  <script slot="head" type="application/ld+json" set:html={structuredData} />
  <SiteHeader />

  <main id="main">
    <!-- 01 Hero -->
    <section class="mo-hero" aria-labelledby="hero-title">
      <div class="container-site mo-hero__grid">
        <div class="mo-hero__copy">
          <p class="mo-eyebrow" data-nosnippet>
            <span aria-hidden="true">01</span> {hero.eyebrow}
          </p>
          <h1 id="hero-title" class="mo-h1">
            {hero.headline}
          </h1>
          <p class="mo-lead">{hero.supporting}</p>
          <div class="mo-actions">
            <EmailLink kind="demo" class="button-primary" primary hint>
              {cta.demo}
            </EmailLink>
            <a class="link-arrow" href="#how">
              {cta.seeHow}
              <ArrowDown size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
          </div>
        </div>

        <div class="mo-hero__device">
          <div class="mo-frame">
            <span class="mo-frame__label mo-frame__label--tl" aria-hidden="true">
              Screen / Today
            </span>
            <span class="mo-frame__label mo-frame__label--br" aria-hidden="true">
              Owner view
            </span>
            <PhoneFrame label={todayScreen.label}>
              <TodayScreen />
            </PhoneFrame>
          </div>
        </div>
      </div>

      <div class="container-site">
        <dl class="mo-specs">
          {hero.specs.map((spec) => (
            <div class="mo-specs__cell">
              <dt>{spec.term}</dt>
              <dd>{spec.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 02 The three questions -->
    <section id="questions" class="mo-section" aria-labelledby="questions-title">
      <div class="container-site">
        <SectionHead
          index="02"
          eyebrow={questions.eyebrow}
          title={questions.headline}
          titleId="questions-title"
        />
        <ol class="mo-grid mo-grid--c3">
          {questions.items.map((item, i) => (
            <li class="mo-q reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <div class="mo-q__top">
                <span class="mo-cell__index" aria-hidden="true">
                  Q{i + 1}
                </span>
                <span class="badge-live">{badges[item.status]}</span>
              </div>
              <div>
                <h3 class="mo-q__question">{item.question}</h3>
                <p class="mo-q__answer">{item.answer}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 03 What it does (Live) -->
    <section id="what" class="mo-section" aria-labelledby="what-title">
      <div class="container-site">
        <SectionHead
          index="03"
          eyebrow={what.eyebrow}
          title={what.headline}
          titleId="what-title"
          intro={what.intro}
        />
        <LiveBento />
      </div>
    </section>

    <!-- 04 One app, three views -->
    <section id="views" class="mo-section" aria-labelledby="views-title">
      <div class="container-site mo-views">
        <SectionHead
          index="04"
          eyebrow={views.eyebrow}
          title={views.headline}
          titleId="views-title"
          intro={views.intro}
        />
        <RoleViews />
      </div>
    </section>

    <!-- 05 A day in the studio -->
    <section id="day" class="mo-section" aria-labelledby="day-title">
      <div class="container-site">
        <SectionHead
          index="05"
          eyebrow={day.eyebrow}
          title={day.headline}
          titleId="day-title"
          intro={day.intro}
        />
        <ol class="mo-day">
          {day.beats.map((beat, i) => (
            <li class="mo-day__beat reveal" style={`--reveal-delay: ${(i % 6) * 80}ms`}>
              <span class="mo-day__time">{beat.time}</span>
              <h3 class="mo-day__title">{beat.title}</h3>
              <p class="mo-day__text">{beat.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 06 Feels like an app -->
    <section id="app" class="mo-section" aria-labelledby="app-title">
      <div class="container-site mo-app">
        <div>
          <SectionHead index="06" eyebrow={app.eyebrow} title={app.headline} titleId="app-title" />
          <ul class="mo-points reveal">
            {app.points.map((point) => (
              <li>
                <FeatureIcon name={point.key} />
                <strong>{point.title}</strong>
                <span>{point.text}</span>
              </li>
            ))}
          </ul>
        </div>

        <figure class="mo-shot">
          <LockScreen />
          <figcaption>{lockScreen.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 07 Roles -->
    <section id="roles" class="mo-section" aria-labelledby="roles-title">
      <div class="container-site">
        <SectionHead
          index="07"
          eyebrow={roles.eyebrow}
          title={roles.headline}
          titleId="roles-title"
          intro={roles.intro}
        />
        <ul class="mo-grid mo-grid--c3">
          {roles.items.map((role, i) => (
            <RoleColumn role={role} index={i} />
          ))}
        </ul>
        <p class="mo-money reveal">
          <Lock size={24} stroke-width={1.5} aria-hidden="true" />
          {roles.money}
        </p>
      </div>
    </section>

    <!-- 08 Coming next -->
    <section id="coming" class="mo-section" aria-labelledby="coming-title">
      <div class="container-site">
        <SectionHead
          index="08"
          eyebrow={coming.eyebrow}
          title={coming.headline}
          titleId="coming-title"
          intro={coming.intro}
        />
        <FeatureTable items={comingFeatures} variant="coming" columns={3} />
      </div>
    </section>

    <!-- 09 Trust -->
    <section id="trust" class="mo-section" aria-labelledby="trust-title">
      <div class="container-site">
        <SectionHead
          index="09"
          eyebrow={trust.eyebrow}
          title={trust.headline}
          titleId="trust-title"
        />
        <FeatureTable items={trust.items} variant="plain" columns={3} />
      </div>
    </section>

    <!-- 10 How it starts -->
    <section id="how" class="mo-section" aria-labelledby="how-title">
      <div class="container-site">
        <SectionHead index="10" eyebrow={how.eyebrow} title={how.headline} titleId="how-title" />
        <FeatureTable items={how.steps} variant="steps" columns={4} />
      </div>
    </section>

    <!-- 11 Closing and contact -->
    <section id="demo" class="mo-section" aria-labelledby="close-title">
      <div class="container-site">
        <p class="mo-eyebrow reveal" data-nosnippet>
          <span aria-hidden="true">11</span> {closing.eyebrow}
        </p>
        <h2 id="close-title" class="mo-close__title reveal">
          {closing.headline}
        </h2>
        <div class="mo-close">
          <p class="mo-close__line reveal">{closing.line}</p>
          <div class="mo-close__panel reveal">
            <ContactBlock />
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
