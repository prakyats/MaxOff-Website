# Names only. Values are set in the Cloudflare dashboard:
# Workers & Pages -> maxoff-site -> Settings -> Variables and Secrets (add each as a Secret).
# For local Worker runs, copy this file to .dev.vars (git-ignored) and fill in test values.

# Cloudflare Turnstile secret key for the maxoff.in widget. Server-side verification only.
TURNSTILE_SECRET_KEY=

# Resend API key with sending-only access. The Worker sends one email per submission.
RESEND_API_KEY=

# Inbox that receives early-access requests.
LEADS_TO=

# Address the lead email is sent from, on a domain verified in Resend, e.g. MaxOff <hello@maxoff.in>.
LEADS_FROM=

# Turnstile site key. Public: it is rendered into the page. Astro exposes PUBLIC_* to the client.
PUBLIC_TURNSTILE_SITE_KEY=
